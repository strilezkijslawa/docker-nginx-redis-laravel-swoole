# ─── Project ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=myapp

# ─── PHP build ────────────────────────────────────────────────────────────────
PHP_VERSION=8.5
# Match your host UID/GID to avoid permission issues with volume mounts:
#   id -u && id -g
USER_ID=1000
GROUP_ID=1000

# ─── Nginx ports ──────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ─── Laravel app ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
# Generate with: php artisan key:generate --show
APP_KEY=base64:CHANGE_ME

# ─── Octane / Swoole ──────────────────────────────────────────────────────────
# Workers = number of CPU cores is a good starting point
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500

# ─── Database ─────────────────────────────────────────────────────────────────
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

LOG_CHANNEL=daily
DEBUGBAR_ENABLED=true

OPCACHE_ENABLE=0
